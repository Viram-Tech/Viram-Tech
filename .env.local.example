# Sanity — copy this file to `.env.local` and fill in your project id.
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the blog uses the built-in
# fallback posts and nothing breaks.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# EmailJS — powers the contact form (https://www.emailjs.com)
#   1. Create a free account, add an Email Service + an Email Template.
#   2. Fill in the three values below in your real `.env.local`, then restart.
# These are NEXT_PUBLIC_* on purpose: EmailJS sends from the browser and the
# public key is safe to expose. The template should reference the form fields:
#   {{firstName}} {{lastName}} {{email}} {{phone}} {{company}} {{designation}} {{message}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# OpenRouter — powers the site chatbot (https://openrouter.ai/keys)
# Server-only, NOT NEXT_PUBLIC_*: this key must never reach the browser.
# Without it the widget still renders but replies that it is unavailable.
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemma-4-26b-a4b-it:free — a free, fast,
# instruction-tuned model. Swap to any OpenRouter slug without a code change.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
